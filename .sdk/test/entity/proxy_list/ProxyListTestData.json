        ],
        "protocol": "http",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "proxies": [
                    {
                      "anonymity": "elite",
                      "country": "US",
                      "ip": "192.168.1.1",
                      "port": 1080,
                      "protocol": "socks5",
