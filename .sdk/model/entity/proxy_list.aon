# Entity: proxy_list

main: kit: entity: proxy_list: {

  alias: field: {}

  fields: [
    {
      name: "anonymity"
      req: false
      short: "Anonymity level of the proxy"
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "Country code of the proxy location"
      type: "`$STRING`"
    }
    {
      name: "ip"
      req: false
      short: "IP address of the proxy server"
      type: "`$STRING`"
    }
    {
      name: "port"
      req: false
      short: "Port number of the proxy server"
      type: "`$INTEGER`"
    }
    {
      name: "protocol"
      req: false
      short: "Protocol type of the proxy"
      type: "`$STRING`"
    }
    {
      name: "timeout"
      req: false
      short: "Timeout value in milliseconds"
      type: "`$INTEGER`"
    }
  ]

  name: "proxy_list"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "elite,anonymous"
                kind: "query"
                name: "anonymity"
                orig: "anonymity"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "us"
                kind: "query"
                name: "country"
                orig: "country"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "json"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "socks5"
                kind: "query"
                name: "protocol"
                orig: "protocol"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "displayproxies"
                kind: "query"
                name: "request"
                orig: "request"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: 6000
                kind: "query"
                name: "timeout"
                orig: "timeout"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/free-proxy-list/get"
          segments: [
            {
              lit: "free-proxy-list"
            }
            {
              lit: "get"
            }
          ]
          select: {
            exist: [
              "anonymity"
              "country"
              "format"
              "protocol"
              "request"
              "timeout"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.proxies`"
          }
        }
      ]
    }
  }



}
